# ─────────────────────────────────────────────────────────────────────────────
# aia-mcp — variables de entorno de ejemplo
# Copia a .env y completa los valores. Se cargan con python-dotenv.
# ─────────────────────────────────────────────────────────────────────────────

# ── FastMCP (host/port/log) ───────────────────────────────────────────────────
FASTMCP_HOST=0.0.0.0
FASTMCP_LOG_LEVEL=INFO
# FASTMCP_PORT se asigna por servidor en mcp_cli/cli.py (8001-8010)

# ── Monitor / estanque (MQTT) ─────────────────────────────────────────────────
MQTT_HOST=broker.mqttdashboard.com
MQTT_PORT=1883
MQTT_USERNAME=test
MQTT_PASSWORD=test
MQTT_TOPIC_OUT=yai-mqtt/01C40A24/out
TINAJA_ALTURA_SENSOR=145
TINAJA_CAPACIDAD_LITROS=5000
# Fallback HTTP si no hay MQTT:
TINAJA_ESTADO_URL=

# ── MongoDB (monitor, charts, airbnb, email) ──────────────────────────────────
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net
AIRBNB_DB=airbnb-db

# ── Email (IMAP Yahoo) ────────────────────────────────────────────────────────
YAHOO_EMAIL=usuario@yahoo.com
YAHOO_APP_PASSWORD=tu-app-password

# ── Wahapedia cache (deshabilitada por defecto) ───────────────────────────────
WAHAPEDIA_CACHE_ENABLED=false
WAHAPEDIA_CACHE_DIR=.aia/cache/wahapedia
WAHAPEDIA_CACHE_TTL_DAYS=60

# ── MangaDex descargas ────────────────────────────────────────────────────────
AIA_MANGA_DIR=.aia/manga

# ── Swagger UI ────────────────────────────────────────────────────────────────
SWAGGER_PORT=8010

# ── aia-jobs API (orquestación BCI) ───────────────────────────────────────────
# URL base del servidor HTTP de aia-jobs (expone /api/jobs/* en :8080).
# Usado por mcp_banco_bci.sync_bci_trx para ejecutar el pipeline completo.
#
# Si AIA_JOBS_API_URL esta definida se usa tal cual. Si NO esta definida,
# el MCP descubre la URL en runtime leyendo /proc/net/route del contenedor
# y usa http://<gateway>:8080 (el gateway del bridge de Docker es el host
# donde corre aia-jobs en red `host`). Asi es robusto ante reinicios del
# daemon que pueden cambiar la subred del bridge.
#
# Sobre-escribir solo si aia-jobs vive en otra maquina o URL distinta:
#   AIA_JOBS_API_URL=http://otro-host:8080
AIA_JOBS_API_URL=
# Timeout en segundos para llamadas al pipeline (transformacion de PDFs puede ser lenta).
AIA_JOBS_TIMEOUT=600

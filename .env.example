# ─────────────────────────────────────────────────────────────────────────────
# aia-mcp — variables de entorno de ejemplo
# Copia a .env y completa los valores. Se cargan con python-dotenv.
# ─────────────────────────────────────────────────────────────────────────────

# ── FastMCP (host/port/log) ───────────────────────────────────────────────────
FASTMCP_HOST=0.0.0.0
FASTMCP_LOG_LEVEL=INFO
# FASTMCP_PORT se asigna por servidor en mcp_cli/cli.py (8001-8010)

# ── Monitor / estanque (MQTT) ─────────────────────────────────────────────────
MQTT_HOST=broker.mqttdashboard.com
MQTT_PORT=1883
MQTT_USERNAME=test
MQTT_PASSWORD=test
MQTT_TOPIC_OUT=yai-mqtt/01C40A24/out
TINAJA_ALTURA_SENSOR=145
TINAJA_CAPACIDAD_LITROS=5000
# Fallback HTTP si no hay MQTT:
TINAJA_ESTADO_URL=

# ── MongoDB (monitor, charts, airbnb, email) ──────────────────────────────────
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net
AIRBNB_DB=airbnb-db

# ── Email (IMAP Yahoo) ────────────────────────────────────────────────────────
YAHOO_EMAIL=usuario@yahoo.com
YAHOO_APP_PASSWORD=tu-app-password

# ── Wahapedia cache (deshabilitada por defecto) ───────────────────────────────
WAHAPEDIA_CACHE_ENABLED=false
WAHAPEDIA_CACHE_DIR=.aia/cache/wahapedia
WAHAPEDIA_CACHE_TTL_DAYS=60

# ── MangaDex descargas ────────────────────────────────────────────────────────
AIA_MANGA_DIR=.aia/manga

# ── Swagger UI ────────────────────────────────────────────────────────────────
SWAGGER_PORT=8010
